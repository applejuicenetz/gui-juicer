FROM ubuntu:18.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libqt4-dev qt4-qmake zlib1g-dev xvfb xauth file ca-certificates curl perl \
 && rm -rf /var/lib/apt/lists/*
# Qt 4.8 lädt zur Laufzeit libssl.so.1.0.0/libcrypto.so.1.0.0 per dlopen und kennt weder OpenSSL 1.1 noch 3.
# Deshalb OpenSSL 1.0.2u als Shared Library bauen; sie wird ins Paket kopiert.
ARG OPENSSL_VERSION=1.0.2u
ARG OPENSSL_SHA256=ecd0c6ffb493dd06707d38b14bb4d8c2288bb7033735606569d8f90f89669d16
RUN curl -fsSL -o /tmp/openssl.tar.gz https://www.openssl.org/source/old/1.0.2/openssl-${OPENSSL_VERSION}.tar.gz \
 && echo "${OPENSSL_SHA256}  /tmp/openssl.tar.gz" | sha256sum -c - \
 && mkdir /tmp/openssl && tar -xzf /tmp/openssl.tar.gz -C /tmp/openssl --strip-components=1 \
 && cd /tmp/openssl \
 && ./config shared --prefix=/opt/openssl-1.0.2 --openssldir=/opt/openssl-1.0.2/ssl \
 && make \
 && make install_sw \
 && rm -rf /tmp/openssl /tmp/openssl.tar.gz
ENV LD_LIBRARY_PATH=/opt/openssl-1.0.2/lib
WORKDIR /work
CMD ["sh", "-ec", "qmake juicer.pro && make -j2"]
